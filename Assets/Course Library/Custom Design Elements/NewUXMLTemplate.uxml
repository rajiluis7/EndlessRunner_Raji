<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="RootContainer" style="flex-grow: 1; background-color: rgb(73, 68, 59); padding: 24px 32px; justify-content: space-between;">
        <ui:Label name="ScoreLabel" text="Score: 0" style="color: rgb(255, 255, 255); font-size: 11px; -unity-font-style: normal; right: 25px; top: -26px; height: 30px; flex-grow: 1;"/>
        <ui:VisualElement name="TopHeader" style="flex-direction: row; justify-content: space-between; align-items: center; width: 100%;"/>
        <ui:Label name="timeLabel" text="Time Remaining: 0" style="color: rgb(255, 255, 255); font-size: 11px; -unity-font-style: normal; right: -420px; top: -61px; -unity-text-auto-size: none; flex-grow: 1;"/>
        <ui:RadioButtonGroup name="timerRadio" choices="Infinite Game,One Minute Game" value="0" style="margin-bottom: 24px; color: rgb(255, 255, 255); font-size: 10px; bottom: -50px; left: 160px; -unity-text-align: upper-center; position: relative; flex-grow: 1;">
            <ui:Button name="_startButton" text="Start" style="width: 150px; height: 30px; font-size: 21px; color: rgb(20, 20, 20); background-color: rgb(198, 198, 198); border-width: 0; border-radius: 0; -unity-text-auto-size: best-fit 10px 100px;"/>
        </ui:RadioButtonGroup>
        <ui:VisualElement name="CenterMenu" style="flex-grow: 1; justify-content: center; align-items: center; width: 286px; top: -175px;"/>
    </ui:VisualElement>
</ui:UXML>
